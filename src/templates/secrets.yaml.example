# session_secret and jwt_secret are auto-generated on first run if absent

# the one key the other services send (it can synth, push and pull)
service_key: ""

oauth:
  twitch:
    client_id: ""
    client_secret: ""
    redirect_uri: "http://localhost:47100/api/auth/oauth/twitch/callback"
  # provider id or login name -> role (admin | mod)
  mappings:
    twitch: {}
